classDiagram
	BaseAuditLog <|-- OrganizationAuditLog
	BaseAuditLog <|-- SFTPConnectionAuditLog
	BaseAuditLog <|-- SFTPConnectionFileSystemAuditLog

	class BaseAuditLog {
		int Id
		int ActorId
		User Actor
		ModelActionEnum Action
		string Source // Ip, websocket, user-agent
		string Diff
		string Timestamp
	}

	class OrganizationAuditLog {
		int OrganizationId
		Organization organization
	}

	class SFTPConnectionAuditLog {
		int SFTPConnectionID
		SFTPConnection SFTPConnection
	}

	class SFTPConnectionFileSystemAuditLog {
		int Id
		FileActionEnum action
		string location
	}